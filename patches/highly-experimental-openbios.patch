diff --git a/Core/psx.c b/Core/psx.c
index 66b313d..65b2965 100644
--- a/Core/psx.c
+++ b/Core/psx.c
@@ -26,6 +26,7 @@ static uint8 library_was_initialized = 0;
 
 static uint32 ps1preboot;
 static uint32 ps2preboot;
+static uint8 preboot_given;
 
 //
 // Deliberately create a NULL dereference
@@ -93,6 +94,16 @@ static uint32 EMU_CALL getenvhex(const char *name) {
   return value;
 }
 
+//
+// Where to stop the BIOS boot, for images without the hebios environment
+// (OpenBIOS). Call before psx_init.
+//
+void EMU_CALL psx_set_preboot(uint32 ps1, uint32 ps2) {
+  ps1preboot = ps1;
+  ps2preboot = ps2;
+  preboot_given = 1;
+}
+
 sint32 EMU_CALL psx_init(void) {
   sint32 r;
   psx_endian_check();
@@ -109,8 +120,10 @@ sint32 EMU_CALL psx_init(void) {
   //
   // Environment inits
   //
-  ps1preboot = getenvhex("ps1preboot");
-  ps2preboot = getenvhex("ps2preboot");
+  if(!preboot_given) {
+    ps1preboot = getenvhex("ps1preboot");
+    ps2preboot = getenvhex("ps2preboot");
+  }
 
   r = iop_init(); if(r) return r;
   r = ioptimer_init(); if(r) return r;
