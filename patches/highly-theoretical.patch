diff --git a/Core/yam.c b/Core/yam.c
index 1e9949a..ecfd4a3 100644
--- a/Core/yam.c
+++ b/Core/yam.c
@@ -24,7 +24,11 @@
 
 #ifndef _WIN32
 #define __cdecl
+#if defined(__i386__)
 #define __fastcall __attribute__((regparm(3)))
+#else
+#define __fastcall
+#endif
 #endif
 
 /* No dynarec for x86_64 yet */
@@ -443,6 +447,10 @@ struct YAM_STATE {
   //
   struct YAM_CHAN chan[64];
   //
+  // Channels left out of the output, one bit each
+  //
+  uint64 mute_mask;
+  //
   // Buffer for dynarec code
   //
 #ifdef ENABLE_DYNAREC
@@ -590,6 +598,10 @@ void EMU_CALL yam_enable_dry(void *state, uint8 enable) {
   YAMSTATE->dry_out_enabled = (enable != 0);
 }
 
+void EMU_CALL yam_set_mute_mask(void *state, uint64 mask) {
+  YAMSTATE->mute_mask = mask;
+}
+
 void EMU_CALL yam_enable_dsp(void *state, uint8 enable) {
   YAMSTATE->dsp_emulation_enabled = (enable != 0);
 #ifdef ENABLE_DYNAREC
@@ -3015,8 +3027,10 @@ fclose(f);
     chan = state->chan + j;
     state->bufptr = bufptr_base + j;
 // is 11
-    render_and_add_channel(state, chan, directout,
-      wantreverb ? (fxbus + chan->dspchan) : NULL,
+    // A muted channel is still generated, for the FM of the others
+    render_and_add_channel(state, chan,
+      ((state->mute_mask >> j) & 1) ? NULL : directout,
+      (wantreverb && !((state->mute_mask >> j) & 1)) ? (fxbus + chan->dspchan) : NULL,
       odometer, samples
     );
   }
