diff --git a/iop/system/sysmem/src/sysmem.c b/iop/system/sysmem/src/sysmem.c
index 59544a47..7d2516d2 100644
--- a/iop/system/sysmem/src/sysmem.c
+++ b/iop/system/sysmem/src/sysmem.c
@@ -38,16 +38,20 @@ typedef struct intrman_callbacks_
 	int (*cbQueryIntrContext)(void);
 } intrman_callbacks_t;
 
+extern char _end[];
+
