 {
 	if ( memsize > 0x7FFF00 )
 		memsize = 0x7FFF00;
-	sysmem_internals.alloclist = (sysmem_alloc_table_t *)0x401100;
+	// As in Sony's sysmem: the table goes in the first 256-byte block past
+	// the end of this module, wherever it was loaded.
+	sysmem_internals.alloclist = (sysmem_alloc_table_t *)(((u32)_end + 0x103) & 0xFFFFFF00);
 	sysmem_internals.memsize = memsize & 0xFFFFFF00;
 	sysmem_internals.intr_suspend_tbl = 0;
 	sysmem_internals.allocation_count = 0;
 	sysmem_internals.smemupdate_cur = 0;
-	if ( (memsize & 0xFFFFFF00) >= 0x401200 )
+	if ( (memsize & 0xFFFFFF00) >= (u32)sysmem_internals.alloclist + 0x100 )
 		return sysmem_reinit();
 	sysmem_internals.alloclist = 0;
 	return 0;
